# The default demo is an explicitly labelled lexical simulation, not an AI model.
NOCAP_PROVIDER=demo
NOCAP_OLLAMA_URL=http://127.0.0.1:11434
NOCAP_OLLAMA_MODEL=qwen3.5:4b
# Any OpenAI-compatible API. Examples:
#   OpenAI     https://api.openai.com/v1
#   DeepSeek   https://api.deepseek.com/v1         model: deepseek-chat
#   Qwen       https://dashscope.aliyuncs.com/compatible-mode/v1
#   LM Studio  http://127.0.0.1:1234/v1   ·  vLLM  http://127.0.0.1:8000/v1
NOCAP_OPENAI_URL=https://api.openai.com/v1
NOCAP_OPENAI_MODEL=
NOCAP_OPENAI_API_KEY=
# A self-hosted Laya server: pip install "laya[serve]"; laya-serve
NOCAP_LAYA_URL=http://127.0.0.1:8123
NOCAP_LAYA_MODEL=english
NOCAP_LAYA_API_KEY=
NOCAP_JEV_URL=https://api.typesafe.ai
NOCAP_JEV_MODEL=jev-latest
NOCAP_JEV_API_KEY=
NOCAP_DATA_DIR=data
NOCAP_TIMEOUT_SECONDS=120
# This is a character budget, NOT a tokenizer guarantee. Inspect the trace and
# configure your Laya server's max_len for the checkpoint you actually use.
NOCAP_LAYA_STATE_CHARS=1600
# Average four cyclic option orders to reduce one documented source of label bias.
NOCAP_LAYA_BALANCE_OPTIONS=true
